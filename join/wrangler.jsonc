{
  "vars": { "REVIEWERS": "TONstories" },
  "name": "repo-neighbor",
  "main": "src/server.ts",
  "compatibility_date": "2026-06-01",
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/auth/*"],
  },
  "durable_objects": { "bindings": [{ "name": "DESK", "class_name": "Desk" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Desk"] }],
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": false },
}
